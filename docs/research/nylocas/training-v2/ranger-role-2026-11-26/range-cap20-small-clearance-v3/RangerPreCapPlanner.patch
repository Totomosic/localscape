+		// Only hold one ready tick before the final ordinary small-removal opportunity.
+		// Actual surviving parent followups remain protected; nothing waits past +6.
+		return room.crabs.stream().anyMatch(c -> c.big && c.wave == 18 && c.hp > 0 && !c.dying
