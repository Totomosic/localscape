+			&& c.style == Style.MELEE && c.hp > 0 && !c.dying && !c.nulled && !c.claimed(tick) && !c.awaitingHit(tick)
+			&& due - c.born >= 9 && due - c.born <= 12 && c.distance(room.player) <= 1
+			&& !room.obstructed.contains(c.key)).findFirst().orElse(null);
+		if (target == null) return -1;
+		for (Crab c : room.crabs)
