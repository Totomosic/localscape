+	private static boolean west30MeleeTakeover(Room room, Crab target, int tick)
+	{
+		int age = tick - target.born;
+		if (room.wave != 31 || target.wave != 30 || target.lane != Lane.WEST || !target.big
+			|| target.style != Style.MELEE || age < 26 || age >= 49) return false;
+		// The partner's complete range window has ended. Finish a surviving
+		// parent before it expires and creates another late pair, while keeping
+		// serviceable own east30/31 work and all partner-NULL rescue ahead.
+		return room.crabs.stream().noneMatch(own -> own.lane == Lane.EAST
+			&& (own.wave == 30 && own.big || own.wave == 31 && !own.big && own.slot == 'N')
+			&& own.style == Style.MAGIC && own.hp > 0 && !own.dying && !own.nulled
+			&& !dimmed(room, own) && tick - own.born < 49 && own.pendingDamage < own.hp);
