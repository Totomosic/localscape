+	Crab west19Followup(Room room, int tick, Reservation reservation)
+	{
+		if (room.wave != 19 || tick < room.ready) return null;
+		for (Crab crab : room.crabs)
+		{
+			int age = tick - crab.born;
+			if (!crab.big || crab.wave != 19 || crab.lane != Lane.WEST || age <= 3 || age > 10
+				|| !strategy.opened(crab) || crab.hp <= 0 || crab.dying || crab.nulled
+				|| crab.claimedUntil > tick || crab.awaitingHit(tick) || room.obstructed.contains(crab.key)
+				|| !RangerFlickers.matchesNext(crab, Style.MAGIC, tick)) continue;
+			Tile target = position(crab, tick, tick + 1);
+			Tile destination = attackTile(room.player, target, true, Weapon.EYE.range);
+			if (room.player.distanceTo(destination) > 2 || distance(destination, target, true) > Weapon.EYE.range) continue;
+			if (reservation != null && tick + Math.max(Weapon.EYE.cooldown,
+				(destination.distanceTo(reservation.rule.stage) + 1) / 2) > reservation.due) continue;
+			if (wave18ReturnFits(room, tick, destination)) return crab;
+		}
+		return null;
+	}
+
+	private boolean wave18ReturnFits(Room room, int tick, Tile from)
+	{
+		List<Crab> remaining = room.crabs.stream().filter(c -> c.big && c.wave == 18 && !c.dying && c.hp > 0)
+			.sorted(Comparator.comparingInt(c -> c.lane.ordinal())).collect(Collectors.toList());
+		int at = tick + Weapon.EYE.cooldown;
+		int moveFrom = tick + 1;
+		for (Crab crab : remaining)
+		{
+			// Reserve observed remaining HP: an airborne hit is never credited as a future kill.
+			if (crab.nulled || crab.claimedUntil > tick || crab.awaitingHit(tick)
+				|| !RangerStrategy.wave18Available(crab, room, tick) || room.obstructed.contains(crab.key)) return false;
+			int attacks = Math.max(1, (crab.hp + 7) / 8);
+			for (int shot = 0; shot < attacks; shot++)
+			{
+				Tile target = position(crab, tick, at + 1);
+				Tile destination = attackTile(from, target, true, Weapon.PIPE.range);
+				int travel = (from.distanceTo(destination) + 1) / 2;
+				at = Math.max(at, moveFrom + Math.max(0, travel - 1));
+				// Same 8-work estimate as the beam, with native pipe impact2 and a following
+				// observation before retrying. Count the final impact, not its unused cooldown.
+				if (at + 2 > crab.born + 26 || predictedStyle(crab, tick, at) != Style.RANGE
+					|| predictedStyle(crab, tick, at + 1) != Style.RANGE
+					|| distance(destination, position(crab, tick, at + 1), true) > Weapon.PIPE.range) return false;
+				from = destination;
+				moveFrom = at + 1;
+				at += 3;
+			}
+		}
+		return true;
 	}
 
