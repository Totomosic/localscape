+package org.localscape.nylocas.ranger;
+
+import org.junit.Test;
+import org.localscape.nylocas.ranger.RangerStrategy.Crab;
+import org.localscape.nylocas.ranger.RangerStrategy.Decision;
+import org.localscape.nylocas.ranger.RangerStrategy.Lane;
+import org.localscape.nylocas.ranger.RangerStrategy.Room;
+import org.localscape.nylocas.ranger.RangerStrategy.Style;
+import org.localscape.nylocas.ranger.RangerStrategy.Weapon;
+
+import static org.junit.Assert.*;
+
+/** First West18 service is a distinct experiment; other transition packets keep their timing. */
+public class RangerEarlyWest18Test
+{
+	private final RangerStrategy strategy = new RangerStrategy();
+	private int key;
+
+	private Room room()
+	{
+		Room room = new Room();
+		room.wave = 18;
+		room.spawns[18] = 100;
+		room.player = RangerStrategy.tile(3295, 4248);
+		room.specialEnergy = 1000;
+		return room;
+	}
+
+	private Crab crab(Room room, int wave, int born, Lane lane, boolean big, Style style, int x, int y)
+	{
+		Crab crab = new Crab(++key, key, born, wave, lane, 'S', big, style, RangerStrategy.tile(x, y));
+		room.crabs.add(crab);
+		return crab;
+	}
+
+	@Test
+	public void firstWest18UsesImmediateBowOverAnOrdinaryReadySplit()
+	{
+		Room room = room();
+		Crab west = crab(room, 18, 100, Lane.WEST, true, Style.RANGE, 3281, 4248);
+		crab(room, 18, 100, Lane.SPLIT, false, Style.RANGE, 3297, 4248);
+		Decision decision = strategy.decide(room, 100);
+		assertSame(west, decision.target);
+		assertEquals(Weapon.BOW, decision.weapon);
+		assertFalse(decision.pathToTarget);
+	}
+
+	@Test
+	public void firstWest18KeepsTheShortPipeWhenItCanLaunchOnTheSameCycle()
+	{
+		Room room = room();
+		room.player = RangerStrategy.tile(3293, 4248);
+		Crab west = crab(room, 18, 100, Lane.WEST, true, Style.RANGE, 3288, 4248);
+		crab(room, 18, 107, Lane.SPLIT, false, Style.RANGE, 3295, 4248);
+		Decision decision = strategy.decide(room, 107);
+		assertSame(west, decision.target);
+		assertEquals(Weapon.PIPE, decision.weapon);
+	}
+
+	@Test
+	public void firstWest18DoesNotIdlePastAnEarlierUsefulAttack()
+	{
+		Room room = room();
+		room.player = RangerStrategy.tile(3301, 4254);
+		crab(room, 18, 100, Lane.WEST, true, Style.RANGE, 3281, 4248);
+		Crab immediate = crab(room, 18, 100, Lane.SPLIT, false, Style.RANGE, 3299, 4254);
+		assertSame(immediate, strategy.decide(room, 100).target);
+	}
+
+	@Test
+	public void firstWest18CanUseCooldownToApproachBeforeOtherEqualTimeWork()
+	{
+		Room room = room();
+		room.player = RangerStrategy.tile(3301, 4254);
+		room.ready = 104;
+		Crab west = crab(room, 18, 100, Lane.WEST, true, Style.RANGE, 3281, 4248);
+		crab(room, 18, 100, Lane.SPLIT, false, Style.RANGE, 3299, 4254);
+		Decision decision = strategy.decide(room, 100);
+		assertSame(west, decision.approach);
+		assertNotEquals(room.player, decision.tile);
+	}
+
+	@Test
+	public void currentClaimOwnFlightAndNullStillReleaseTheFirstWest18Choice()
+	{
+		for (int unavailable = 0; unavailable < 3; unavailable++)
+		{
+			strategy.reset();
+			Room room = room();
+			Crab west = crab(room, 18, 100, Lane.WEST, true, Style.RANGE, 3281, 4248);
+			if (unavailable == 0) west.claimedUntil = 140;
+			if (unavailable == 1)
+			{
+				west.ownHitUntil = 132;
+				west.ownHitHp = 0;
+			}
+			if (unavailable == 2) west.nulled = true;
+			Crab available = crab(room, 18, 100, Lane.SPLIT, false, Style.RANGE, 3297, 4248);
+			assertSame(available, strategy.decide(room, 100).target);
+		}
+	}
+
+	@Test
+	public void southAndEast18StillWaitForTheirActual19Guide()
+	{
+		Room room = room();
+		crab(room, 18, 100, Lane.SOUTH, true, Style.RANGE, 3295, 4243);
+		crab(room, 18, 100, Lane.EAST, true, Style.RANGE, 3301, 4248);
+		Crab available = crab(room, 18, 107, Lane.SPLIT, false, Style.RANGE, 3297, 4248);
+		assertSame(available, strategy.decide(room, 107).target);
+	}
+
+	@Test
+	public void aFirstWest18ChoiceCannotStealTheActual19PacketTick()
+	{
+		Room room = room();
+		room.wave = 19;
+		room.spawns[19] = 108;
+		room.player = RangerStrategy.tile(3293, 4248);
+		crab(room, 18, 100, Lane.WEST, true, Style.RANGE, 3290, 4248);
+		Crab nineteen = crab(room, 19, 108, Lane.WEST, true, Style.MAGIC, 3284, 4248);
+		Decision decision = strategy.decide(room, 111);
+		assertSame(nineteen, decision.target);
+		assertEquals("West magic big 19", decision.rule);
+	}
+
+	@Test
+	public void aFirstWest18ChoiceCannotStealTheActual20BowTick()
+	{
+		Room room = room();
+		room.wave = 20;
+		room.spawns[19] = 108;
+		room.spawns[20] = 120;
+		room.player = RangerStrategy.tile(3293, 4248);
+		crab(room, 18, 102, Lane.WEST, true, Style.RANGE, 3290, 4248);
+		Crab twenty = crab(room, 20, 120, Lane.WEST, true, Style.RANGE, 3286, 4248);
+		Decision decision = strategy.decide(room, 125);
+		assertSame(twenty, decision.target);
+		assertEquals("West bow flicker 20", decision.rule);
+	}
+}
