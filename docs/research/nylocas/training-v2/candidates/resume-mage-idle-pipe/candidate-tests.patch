+	@Test public void idlePreCapPipeSupportsOnlyFreshRangedSplits()
+	{
+		Room r = room(18, 100, 3295, 4248);
+		Crab split = crab(r, 18, 100, Lane.SPLIT, (char) 0, false, Style.RANGE, 3296, 4248);
+		Decision d = strategy.decide(r, 102);
+		assertSame(split, d.target); assertEquals(Weapon.PIPE, d.weapon);
+		assertEquals("Idle ranged split support", d.reason);
+		assertNull(strategy.decide(r, 105).target);
+	}
+	@Test public void idlePipeNeverDisplacesOwnReadyMagicOrMelee()
+	{
+		Room r = room(18, 100, 3295, 4248);
+		crab(r, 18, 100, Lane.SPLIT, (char) 0, false, Style.RANGE, 3296, 4248);
+		Crab magic = crab(r, 18, 100, Lane.SPLIT, (char) 0, false, Style.MAGIC, 3295, 4249);
+		assertSame(magic, strategy.decide(r, 102).target);
+		magic.dying = true; strategy.reset();
+		Crab melee = crab(r, 18, 100, Lane.SPLIT, (char) 0, false, Style.MELEE, 3294, 4248);
+		assertSame(melee, strategy.decide(r, 102).target);
+	}
+	@Test public void idlePipeNeverDisplacesAnOwnFutureApproach()
+	{
+		Room r = room(18, 100, 3290, 4248);
+		crab(r, 18, 100, Lane.SPLIT, (char) 0, false, Style.RANGE, 3291, 4248);
+		Crab magic = crab(r, 18, 100, Lane.SPLIT, (char) 0, false, Style.MAGIC, 3303, 4248);
+		Decision d = strategy.decide(r, 102);
+		assertTrue(d.target == magic || d.approach == magic); assertEquals(Weapon.EYE, d.weapon);
+	}
+	@Test public void idlePipeDoesNotApproachBlockedOrDistantPartnerWork()
+	{
+		Room r = room(18, 100, 3295, 4248);
+		Crab split = crab(r, 18, 100, Lane.SPLIT, (char) 0, false, Style.RANGE, 3296, 4248);
+		r.obstructed.add(split.key); Decision blocked = strategy.decide(r, 102);
+		assertNull(blocked.target); assertNull(blocked.approach);
+		r.obstructed.clear(); split.point = MageStrategy.tile(3302, 4248);
+		Decision distant = strategy.decide(r, 102); assertNull(distant.target); assertNull(distant.approach);
+	}
+	@Test public void idlePipeHonorsNullClaimOwnFlightAndDeath()
+	{
+		Room r = room(18, 100, 3295, 4248);
+		Crab split = crab(r, 18, 100, Lane.SPLIT, (char) 0, false, Style.RANGE, 3296, 4248);
+		split.nulled = true; assertNull(strategy.decide(r, 102).target);
+		split.nulled = false; split.claimedUntil = 105; assertNull(strategy.decide(r, 102).target);
+		split.claimedUntil = 0; split.ownHitUntil = 105; split.ownHitHp = 0;
+		assertNull(strategy.decide(r, 102).target);
+		split.ownHitUntil = 0; split.dying = true; assertNull(strategy.decide(r, 102).target);
+	}
