+		for (Candidate fresh : candidates)
+		{
+			Crab c = fresh.decision.target;
+			if (c.born < tick - 2 || c.wave <= target.wave || fresh.at <= tick || fresh.at > tick + 2) continue;
+			Decision wait = waitForFresh(room.wave, "seen:" + c.key, fresh.at, tick, fresh.decision.weapon, fresh.position);
+			if (wait != null) { wait.approach = c; return wait; }
+		}
+		int upcoming = room.wave + 1, born = spawn(room, upcoming, tick);
+		if (born >= tick && born <= tick + 2)
+		{
+			for (Assignment a : ASSIGNMENTS)
+			{
+				if (a.wave != upcoming) continue;
+				Tile origin = a.lane == Lane.WEST ? tile(3281, a.big || a.slot == 'S' ? 4248 : 4249)
+					: a.lane == Lane.EAST ? tile(a.big ? 3309 : 3310, a.big || a.slot == 'S' ? 4248 : 4249)
+					: tile(a.big || a.slot == 'W' ? 3295 : 3296, 4233);
+				for (int at = Math.max(tick, born); at <= tick + 2; at++)
+				{
+					Tile point = AttackTiming.position(origin, a.lane.ordinal(), 0, at + 1 - born);
+					Tile position = AttackTiming.attackTile(room.player, point, a.big, a.weapon.range);
+					int travel = Math.max(0, (room.player.distanceTo(position) + 1) / 2 - 1);
+					int back = next == null ? 0 : (position.distanceTo(next.stage) + 1) / 2;
+					if (tick + travel > at || AttackTiming.distance(position, point, a.big) > a.weapon.range
+						|| next != null && at + Math.max(a.weapon.cooldown, back) > next.due) continue;
+					Decision wait = waitForFresh(room.wave, "lane:" + upcoming, Math.max(tick + 1, at), tick, a.weapon, a.stage);
+					if (wait != null) return wait;
+					break;
+				}
+			}
+		}
+		// Big combat death is five animation ticks, plus up to three moving ticks.
+		// Predict only the observed late body interval; a missed forecast releases in two ticks.
+		for (Crab parent : room.crabs)
+		{
+			Integer seen = parentDeathSeen.get(parent.key);
+			if (seen == null || parent.wave <= target.wave) continue;
+			int birth = seen + 7;
+			if (birth <= tick || birth > tick + 2) continue;
+			Tile position = AttackTiming.attackTile(room.player, parent.point, true, 1);
+			if (next != null && birth + (position.distanceTo(next.stage) + 1) / 2 > next.due) continue;
+			Decision wait = waitForFresh(room.wave, "parent:" + parent.key, birth, tick, Weapon.EYE, position);
+			if (wait != null) return wait;
+		}
+		return null;
+	}
