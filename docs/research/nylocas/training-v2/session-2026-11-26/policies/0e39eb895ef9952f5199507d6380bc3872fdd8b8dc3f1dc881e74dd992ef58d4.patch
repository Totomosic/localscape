+	private Decision anticipateFresh(Room room, int tick, Candidate old, Window next, List<Candidate> candidates)
+	{
+		Crab target = old.decision.target;
+		if (room.wave >= 20 || tick < room.ready || room.wave - target.wave < 4 || target.big
+			|| old.decision.rule != null || target.partnerNulled || next != null && next.due <= tick + 2) return null;
