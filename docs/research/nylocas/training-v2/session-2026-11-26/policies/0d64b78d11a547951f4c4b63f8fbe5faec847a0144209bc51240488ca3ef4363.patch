+					Tile position = AttackTiming.attackTile(room.player, point, a.big, a.weapon.range);
+					int travel = Math.max(0, (room.player.distanceTo(position) + 1) / 2 - 1);
+					int back = next == null ? 0 : (position.distanceTo(next.stage) + 1) / 2;
+					if (tick + travel > at || AttackTiming.distance(position, point, a.big) > a.weapon.range
+						|| next != null && at + Math.max(a.weapon.cooldown, back) > next.due) continue;
+					Decision wait = waitForFresh(room.ready, "lane:" + upcoming, Math.max(tick + 1, at), tick, a.weapon, a.stage);
