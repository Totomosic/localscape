+		// ready allowance; changing wave, parent or child identity never does.
+		if (tick < ready) return stage(weapon, position, "Approach fresh during cooldown: " + key);
+		if (freshWaitUntil < 0) freshWaitUntil = Math.min(tick + 1, at - 1);
