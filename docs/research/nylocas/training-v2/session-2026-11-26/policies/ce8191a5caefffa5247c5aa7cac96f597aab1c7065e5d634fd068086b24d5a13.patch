+	private void preferFreshWithinTwo(List<Plan> choices, Room room, int tick, int ready)
+	{
+		if (choices.get(0).shots.size() != 1) return;
+		int earliest = choices.stream().mapToInt(p -> p.shots.get(0).tick).min().getAsInt();
+		if (choices.stream().noneMatch(p -> p.shots.get(0).tick == earliest && ordinaryOldUnhit(last(p), room))) return;
+		if (choices.stream().anyMatch(p -> p.shots.get(0).tick == earliest && last(p).target.wave < room.wave - 1
+			&& !ordinaryOldUnhit(last(p), room))) return;
+		if (choices.stream().anyMatch(p -> p.shots.get(0).tick <= earliest + 2 && last(p).target.wave < room.wave - 1
+			&& (last(p).rule != null || last(p).target.big))) return;
+		List<Plan> fresh = choices.stream().filter(p -> p.shots.get(0).tick <= earliest + 2 && last(p).target.wave >= room.wave - 1)
+			.filter(p -> !(last(p).weapon == Weapon.BOW && last(p).rule == null && choices.stream().anyMatch(f ->
+				last(f).target.key == last(p).target.key && last(f).weapon == Weapon.PIPE && last(f).rule != null
+					&& f.shots.get(0).tick <= earliest + 2))).collect(Collectors.toList());
+		if (fresh.isEmpty()) return;
+		boolean wait = fresh.stream().mapToInt(p -> p.shots.get(0).tick).min().getAsInt() > earliest;
+		if (wait && tick >= ready && readyFreshWaitTicks >= 2) return;
+		choices.retainAll(fresh);
+		if (wait) choices.forEach(p -> p.freshWait = true);
+	}
