+		for (Candidate fresh : candidates)
+		{
+			Crab c = fresh.decision.target;
+			if (c.born < tick - 2 || c.wave <= target.wave || fresh.at <= tick || fresh.at > horizon) continue;
+			Decision wait = waitForFresh(room.ready, "seen:" + c.key, fresh.at, tick, fresh.decision.weapon, fresh.position);
+			if (wait != null) { wait.approach = c; return wait; }
+		}
